# Server Running port (local dev)
PORT=3000

# Google AI Studio API Key (For Gemini Model access)
GEMINI_API_KEY=AIzaSy...

# YouTube Data API v3 Key (For educational video recommendations)
YOUTUBE_API_KEY=AIzaSy...

# Firebase Admin SDK Configuration (For backend serverless access to Firestore)
# To get these values, generate a new Private Key JSON in Firebase Console -> Project Settings -> Service Accounts.
FIREBASE_PROJECT_ID=au-learning-xxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@au-learning-xxxx.iam.gserviceaccount.com
# Keep the private key enclosed in quotes, replacing newlines (\n) with literal \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
